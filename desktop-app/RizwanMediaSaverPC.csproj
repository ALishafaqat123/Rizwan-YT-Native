<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Rizwan Media Saver PC</AssemblyName>
    <RootNamespace>RizwanMediaSaverPC</RootNamespace>
    <Version>1.1.1</Version>
    <Company>Muhammad Rizwan</Company>
    <Product>Rizwan Media Saver PC</Product>
    <Description>Browser-first ad-free desktop media saver with instant YouTube page analysis, yt-dlp, FFmpeg and audio language selection.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
</Project>
