<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Rizwan Media Saver PC</AssemblyName>
    <RootNamespace>RizwanMediaSaverPC</RootNamespace>
    <Version>1.1.3</Version>
    <Company>Muhammad Rizwan</Company>
    <Product>Rizwan Media Saver PC</Product>
    <Description>Browser-first desktop media saver with WebView YouTube session bridge, Rich Audio Scan, yt-dlp and FFmpeg.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
</Project>
